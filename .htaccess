# Finmatrix Apache Web Server Configuration (Hostinger / cPanel / Shared Hosting)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://finmatrix.cloud/$1 [L,R=301]

  # 2. Canonicalize WWW to Non-WWW
  RewriteCond %{HTTP_HOST} ^www\.finmatrix\.cloud [NC]
  RewriteRule ^(.*)$ https://finmatrix.cloud/$1 [L,R=301]

  # Serve index.html for directory requests
  DirectoryIndex index.html

  # 3. Redirect Legacy Articles to Calculators
  RewriteRule ^articles/avalanche-vs-snowball-debt\.html$ /calculators/debt-elimination-planner.html [R=301,L]
  RewriteRule ^articles/ultimate-credit-card-debt-elimination-guide\.html$ /calculators/credit-card-payoff-calculator.html [R=301,L]
  RewriteRule ^articles/hysa-vs-cd-2025\.html$ /calculators/hysa-vs-cd-calculator.html [R=301,L]
  RewriteRule ^articles/rent-vs-buy-2025\.html$ /calculators/rent-vs-buy-calculator.html [R=301,L]
  RewriteRule ^articles/roth-ira-vs-401k\.html$ /calculators/roth-vs-traditional-ira-calculator.html [R=301,L]
  RewriteRule ^articles/how-to-build-emergency-fund\.html$ /calculators/emergency-fund-calculator.html [R=301,L]
  RewriteRule ^articles/50-30-20-rule-budgeting\.html$ /calculators/paycheck-calculator.html [R=301,L]
  RewriteRule ^articles/what-is-the-4-percent-rule\.html$ /calculators/fire-calculator.html [R=301,L]
  RewriteRule ^articles/boost-credit-score-30-days\.html$ /calculators/debt-elimination-planner.html [R=301,L]
  RewriteRule ^articles/investing-50-dollars\.html$ /calculators/compound-interest-calculator.html [R=301,L]
  RewriteRule ^articles/side-hustles-1000-month\.html$ /calculators/hourly-to-salary-calculator.html [R=301,L]
  RewriteRule ^articles/?$ /calculators/ [R=301,L]
  RewriteRule ^articles/index\.html$ /calculators/ [R=301,L]

  # Do NOT rewrite real existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Serve .html files without requiring extension in URL
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Enforce Correct MIME Types
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType image/svg+xml .svg
</IfModule>

# Security & Modern SEO Headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  SetEnvIf Request_URI "^/embed/" IS_EMBED
  Header always set X-Frame-Options "ALLOWALL" env=IS_EMBED
  Header always set Content-Security-Policy "frame-ancestors *" env=IS_EMBED
  Header always set X-Frame-Options "SAMEORIGIN" env=!IS_EMBED
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(svg|png|jpg|ico|webp)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
